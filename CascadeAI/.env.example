# ─── CascadeAI environment ─────────────────────────────────────────
# Copy this file to CascadeAI/.env and fill in your own values.
# Never commit the populated .env — it is git-ignored.

# ─── Gemma 4 backend ───────────────────────────────────────────────
# Pick ONE of the two blocks below.

# Option A: Google AI Studio (cloud)
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_API_KEY=your-google-ai-studio-key-here
GEMMA_MODEL=gemma-4-31b-it

# Option B: Ollama (local / edge) — uncomment and comment out Option A
# GEMMA_API_BASE=http://localhost:11434/v1
# GEMMA_API_KEY=ollama
# GEMMA_MODEL=gemma4:e2b

# ─── Optional data-fetcher API keys ────────────────────────────────
# All fetchers fall back to baseline cached data if these are unset.

# EIA (US Energy Information Administration) — energy commodity prices
EIA_API_KEY=

# ACLED (Armed Conflict Location & Event Data) — needs key + email
ACLED_API_KEY=
ACLED_EMAIL=
