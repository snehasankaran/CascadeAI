# =============================================================================
# Streamlit Community Cloud / Hugging Face Spaces — Secrets template
# =============================================================================
# COPY THIS BLOCK into the "Secrets" editor when deploying.
# Streamlit Cloud:  App settings -> Secrets   (raw TOML)
# HF Spaces:        Space settings -> Variables and secrets   (one row per key)
#
# DO NOT commit this file with real values. The repo's .env is gitignored;
# this .example file stays in source only as a template.
# =============================================================================

# --- Required: Gemma 4 backend ----------------------------------------------
# Option A: Google AI Studio (cloud, recommended for hosted demos)
GEMMA_API_BASE = "https://generativelanguage.googleapis.com/v1beta"
GEMMA_API_KEY  = "REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY"
GEMMA_MODEL    = "gemma-4-31b-it"

# Option B: Ollama (local only — NOT usable from cloud-hosted Streamlit Cloud)
# GEMMA_API_BASE = "http://localhost:11434/v1"
# GEMMA_API_KEY  = "ollama"
# GEMMA_MODEL    = "gemma4:e2b"

# --- Optional: live humanitarian data spines --------------------------------
# Action Watch falls back to public RSS / HDX XLSX when these are unset.
# Setting them gives you full-fidelity ReliefWeb v2 + ACLED v3 data.
#
# RELIEFWEB_APPNAME = "cascadeai-demo"            # any short app identifier
# ACLED_API_KEY     = "REPLACE_WITH_ACLED_KEY"
# ACLED_EMAIL       = "your-email@example.com"

# --- Optional: corporate proxy (only needed for self-hosting) ---------------
# The hosted demo doesn't need these. gemma_client.py auto-bypasses them
# for localhost/127.0.0.1 endpoints.
#
# HTTPS_PROXY = "http://proxy.example.com:8080"
# HTTP_PROXY  = "http://proxy.example.com:8080"
